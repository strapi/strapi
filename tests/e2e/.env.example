# Specify any environment variables you would like to use for your tests

# Examples:
STRAPI_LICENSE=your_license_key

# Piwi Dashboard reporter (opt-in: only active when PIWI_DASHBOARD_URL is set)
PIWI_DASHBOARD_URL=https://test-health.tools.strapi.team
PIWI_API_KEY=
# Upload budget in ms at the end of each run (default 60000)
# PIWI_SUBMIT_TIMEOUT=60000
# Capture fixtures (locators, page state, network): slower tests, off by default
# PIWI_FIXTURES=true
