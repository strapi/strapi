{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "node20",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // Fixtures are `.ts`, not `.d.ts`, so they are type checked despite `skipLibCheck`
  "files": ["./fixtures/content-types.ts"],
  "include": ["./**/*.test-d.ts"]
}
