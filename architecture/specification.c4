specification {
  element person {
    notation 'Person'
    style {
      shape person
      color slate
    }
  }

  element external_system {
    notation 'External System'
    style {
      shape rectangle
      color gray
    }
  }

  element software_system {
    notation 'Software System'
    style {
      shape rectangle
      color blue
    }
  }

  element container {
    notation 'Container'
    style {
      shape rectangle
      color indigo
    }
  }

  element component {
    notation 'Component'
    style {
      shape rectangle
      color sky
    }
  }

  element code_package {
    notation 'Code Package'
    style {
      shape rectangle
      color green
    }
  }

  element source_document {
    notation 'Source Document'
    style {
      shape document
      color green
    }
  }

  element database {
    notation 'Database'
    style {
      shape cylinder
      color amber
    }
  }

  element capability {
    notation 'Product capability (not a runtime unit)'
    style {
      shape rectangle
      color secondary
    }
  }

  element concept {
    notation 'Domain concept (not a runtime unit)'
    style {
      shape rectangle
      color secondary
    }
  }

  deploymentNode environment {
    notation 'Example environment'
    style { color slate }
  }
  deploymentNode device {
    notation 'Browser device'
    style { color slate }
  }
  deploymentNode host {
    notation 'Self-hosted infrastructure'
    style { color slate }
  }

  tag runtime_boundary

  relationship reads
  relationship writes
  relationship authenticates
  relationship authorizes
  relationship registers
  relationship delegates
}
