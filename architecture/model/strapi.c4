model {
  public_client = external_system 'Consuming application' {
    summary 'Website, mobile app or service that requests content.'
    description 'Application that consumes published content through Strapi Content APIs, such as a browser app, mobile app, frontend site, or backend-for-frontend.'
  }

  content_editor = person 'Content editor' {
    summary 'Creates and publishes content in the Admin.'
    description 'Admin panel user whose primary job is to create, edit, review, publish, and manage content entries through the Content Manager.'
  }

  developer = person 'Developer' {
    summary 'Builds content models and custom application behaviour.'
    description 'Builder of the Strapi application. Uses the CLI, code, Content-Type Builder, and deployment workflows to configure schemas, APIs, extensions, and runtime behavior.'
  }

  administrator = person 'Administrator' {
    summary 'Manages admin access and application settings.'
    description 'Operational admin user responsible for settings such as users, roles, permissions, API tokens, transfer tokens, webhooks, and admin configuration.'
  }

  external_system = external_system 'Webhook receiver' {
    summary 'Receives optional content and media events.'
    description 'An optional business system that receives configured Strapi webhook events. Hosting, email and media storage are separate concerns.'
  }

  strapi = software_system 'Strapi CMS' {
    summary 'Model, manage and deliver structured content.'

    description 'A typical application built with Strapi: a self-hosted CMS with a browser Admin, a Node.js server and persistent data. Development artifacts are documented separately from the runtime views.'

    server_runtime = container 'Strapi server runtime' {
      summary 'Node.js process running APIs, plugins and content operations.'

      description 'Node.js runtime that loads Strapi, registers APIs, serves HTTP routes, executes content operations, and talks to persistence.'
      technology 'Node.js / Koa'

      http_server = component 'HTTP server and Koa router' {
        summary 'Accepts HTTP requests and dispatches matched routes.'
        description 'Creates the HTTP server, mounts admin and Content API routes, and dispatches requests through Koa routing.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/server' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/server 'Implementation'
      }

      route_registration = component 'Route registration' {
        summary 'Mounts application, admin and plugin routes at startup.'
        description 'Registers admin routes and app API routes. App API routers are tagged as content-api.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/server/register-routes.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/server/register-routes.ts 'Implementation'
      }

      endpoint_composer = component 'Endpoint composer' {
        summary 'Builds each route’s auth, policy and controller chain.'
        description 'Builds each Koa route handler chain with route metadata, authentication, authorization, policies, middlewares, return body middleware, and controller action.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/server/compose-endpoint.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/server/compose-endpoint.ts 'Implementation'
      }

      schema_loader = component 'Content type schema loader' {
        summary 'Loads content definitions during application startup.'
        description 'Loads application and plugin content type schemas into the Strapi runtime during startup.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core loaders, content type schemas' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core 'Implementation'
      }

      schema_sync = component 'Database schema sync' {
        summary 'Brings database tables into line with loaded schemas.'
        description 'Synchronizes loaded content type definitions with database metadata and tables through the database layer.'
        technology '@strapi/database schema sync'
      }

      api_module_loader = component 'API module loader' {
        summary 'Loads application routes, controllers and services.'
        description 'Loads application API route, controller, service, policy, and middleware modules that make up the runtime Content API surface.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core loaders' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core 'Implementation'
      }

      content_api = component 'Content API service' {
        summary 'Exposes route metadata, permissions and validation helpers.'

        description 'Framework service exposed as strapi.contentAPI. Owns Content API route metadata, permissions utilities, validation, sanitization, and extra route schemas.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/content-api' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/content-api 'Implementation'

        ca_route_metadata = code_package 'Route metadata' {
          summary 'Content API route information used to identify route type, action names, and permission scope'
          description 'Content API route information used to identify route type, action names, and permission scope.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/content-api' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/content-api 'Implementation'
        }

        ca_permission_providers = code_package 'Permission providers' {
          summary 'Permission action discovery and ability generation helpers for Content API routes'
          description 'Permission action discovery and ability generation helpers for Content API routes.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/content-api/permissions' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/content-api/permissions 'Implementation'
        }

        ca_validation_helpers = code_package 'Validation and sanitization helpers' {
          summary 'Helpers exposed to controllers for Content API query, input, and output validation and sanitization'
          description 'Helpers exposed to controllers for Content API query, input, and output validation and sanitization.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/content-api' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/content-api 'Implementation'
        }

        ca_route_schemas = code_package 'Extra route schemas' {
          summary 'Route-level schemas used by Content API validation and sanitization'
          description 'Route-level schemas used by Content API validation and sanitization.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/content-api' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/content-api 'Implementation'
        }
      }

      content_api_permissions = component 'Content API permissions utilities' {
        summary 'Discovers actions and creates permission abilities.'
        description 'Discovers Content API controller actions, registers permission actions, and generates abilities.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/content-api/permissions' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/content-api/permissions 'Implementation'
      }

      content_api_validation = component 'Content API validation and sanitization' {
        summary 'Validates and sanitizes API inputs and outputs.'
        description 'Validates and sanitizes Content API query, input, and output using content type schemas and auth context.'
        technology '@strapi/utils validate/sanitize'
      }

      auth = component 'Authentication and authorization' {
        summary 'Selects authentication strategies and checks route access.'

        description 'Strategy registry and authorization layer selected by route.info.type.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/auth' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/auth 'Implementation'

        auth_strategy_registry = code_package 'Strategy registry' {
          summary 'Registry of authentication strategies selected by route type'
          description 'Registry of authentication strategies selected by route type.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/auth' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/auth 'Implementation'
        }

        auth_request_context = code_package 'Request auth context' {
          summary 'Request-scoped authentication state passed through policies, controllers, and permission checks'
          description 'Request-scoped authentication state passed through policies, controllers, and permission checks.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/auth' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/auth 'Implementation'
        }

        auth_authorization_step = code_package 'Authorization step' {
          summary 'Ability checks and authorization result handling before controller execution'
          description 'Ability checks and authorization result handling before controller execution.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/auth' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/auth 'Implementation'
        }
      }

      content_api_token_strategy = component 'Content API token strategy' {
        summary 'Authenticates API tokens and verifies their scopes.'
        description 'Authenticates API tokens, handles full/read-only/custom token behavior, and verifies route scopes.'
        technology 'React / TypeScript'
        metadata { implementation 'packages/core/admin/server/src/strategies/content-api-token.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/admin/server/src/strategies/content-api-token.ts 'Implementation'
      }

      users_permissions_strategy = component 'Users-permissions strategy' {
        summary 'Authenticates JWT users or applies public-role permissions.'
        description 'Authenticates JWT users or public role permissions and generates Content API abilities.'
        technology 'JavaScript'
        metadata { implementation 'packages/plugins/users-permissions/server/src/strategies/users-permissions.js' }
        link https://github.com/strapi/strapi/tree/develop/packages/plugins/users-permissions/server/src/strategies/users-permissions.js 'Implementation'
      }

      core_api_layer = component 'Generated core API layer' {
        summary 'Default routers, controllers and services for content types.'

        description 'Factory-generated routers, controllers, and services for collection and single content types.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/core-api' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/core-api 'Implementation'

        core_api_routes = code_package 'Generated routers' {
          summary 'Factory-generated collection type and single type routers'
          description 'Factory-generated collection type and single type routers.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/core-api/routes' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/core-api/routes 'Implementation'
        }

        core_api_controllers = code_package 'Generated controllers' {
          summary 'Factory-generated controller actions that validate, sanitize, and delegate content operations'
          description 'Factory-generated controller actions that validate, sanitize, and delegate content operations.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/core-api/controller' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/core-api/controller 'Implementation'
        }

        core_api_services = code_package 'Generated services' {
          summary 'Factory-generated service methods for content operations'
          description 'Factory-generated service methods for content operations.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/core-api/service' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/core-api/service 'Implementation'
        }
      }

      admin_server_apis = component 'Admin server APIs' {
        summary 'Handles admin identity, access and settings APIs.'
        description 'Server-side admin module that registers admin routes, controllers, services, content types, auth, permissions, and optional static admin panel serving.'
        technology 'React / TypeScript'
        metadata { implementation 'packages/core/admin/server, packages/core/core/src/loaders/admin.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/admin/server 'Implementation'
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/loaders/admin.ts 'Implementation'
      }

      content_manager_server = component 'Content Manager server module' {
        summary 'Provides content editing and publishing APIs.'

        description 'Admin-facing content editing APIs and services for collection types, single types, relations, publishing, history, and preview integrations.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server 'Implementation'

        cm_server_routes_code = code_package 'Server routes' {
          summary 'Admin route definitions for initialization, configuration, content operations, relations, history, preview, and homepage'
          description 'Admin route definitions for initialization, configuration, content operations, relations, history, preview, and homepage.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-manager/server/src/routes' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/routes 'Implementation'
        }

        cm_server_controllers_code = code_package 'Server controllers' {
          summary 'Controller modules that handle Content Manager admin requests'
          description 'Controller modules that handle Content Manager admin requests.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-manager/server/src/controllers' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/controllers 'Implementation'
        }

        cm_server_services_code = code_package 'Server services' {
          summary 'Services for document operations, permissions, populate planning, metadata, schema configuration, UID generation, and field sizing'
          description 'Services for document operations, permissions, populate planning, metadata, schema configuration, UID generation, and field sizing.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-manager/server/src/services' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/services 'Implementation'
        }

        cm_server_middlewares_code = code_package 'Server middlewares' {
          summary 'Content Manager middleware that prepares route context before controller execution'
          description 'Content Manager middleware that prepares route context before controller execution.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-manager/server/src/middlewares' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/middlewares 'Implementation'
        }

        cm_server_feature_modules_code = code_package 'History, preview, and homepage modules' {
          summary 'Feature modules that contribute additional routes, controllers, and services to Content Manager'
          description 'Feature modules that contribute additional routes, controllers, and services to Content Manager.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-manager/server/src/history, preview, homepage' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/history 'Implementation'
        }
      }

      cm_routes = component 'Content Manager routes' {
        summary 'Declares Content Manager admin endpoints.'
        description 'Admin route definitions for initialization, content type configuration, components, UID generation, relations, collection types, single types, history, preview, and homepage.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/routes' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/routes 'Implementation'
      }

      cm_routing_middleware = component 'Content Manager routing middleware' {
        summary 'Adds content-model context to admin requests.'
        description 'Content Manager route middleware that attaches model-aware routing context before controller execution.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/middlewares/routing.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/middlewares/routing.ts 'Implementation'
      }

      cm_controllers = component 'Content Manager controllers' {
        summary 'Coordinates permissions and content operations.'
        description 'Controller handlers for collection types, single types, components, content types, relations, UID generation, initialization, history, preview, and homepage.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/controllers' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/controllers 'Implementation'
      }

      cm_document_manager = component 'Content Manager document-manager service' {
        summary 'Performs admin document operations.'
        description 'Service that performs admin content operations through strapi.documents and targeted database queries for locale, count, existence, and pagination checks.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/services/document-manager.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/services/document-manager.ts 'Implementation'
      }

      cm_permission_services = component 'Content Manager permission services' {
        summary 'Checks admin permissions for content operations.'
        description 'Permission and permission-checker services used by Content Manager controllers to evaluate admin access to content operations.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/services/permission*.ts' }
      }

      cm_populate_metadata = component 'Content Manager populate and metadata services' {
        summary 'Builds populated responses and document metadata.'
        description 'Services that build populate plans, map data, compute document metadata, and resolve field sizing for Content Manager responses.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/services/populate-builder.ts, data-mapper.ts, document-metadata.ts, field-sizes.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/services/populate-builder.ts 'Implementation'
      }

      cm_schema_configuration = component 'Content Manager schema and configuration services' {
        summary 'Provides editing layouts and model configuration.'
        description 'Services for content type and component configuration surfaced to the Admin Content Manager UI.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/services/content-types.ts, components.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/services/content-types.ts 'Implementation'
      }

      cm_history_preview_homepage = component 'Content Manager history, preview, and homepage modules' {
        summary 'Adds history, preview and homepage behaviour.'
        description 'Feature modules that add history, preview, and homepage routes, controllers, and services to the Content Manager server module.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-manager/server/src/history, preview, homepage' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-manager/server/src/history 'Implementation'
      }

      content_type_builder_server = component 'Content-Type Builder server module' {
        summary 'Edits application schemas during development.'

        description 'Admin-facing schema management APIs and services for content types, components, and schema builder behavior.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/content-type-builder/server' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server 'Implementation'

        ctb_server_routes = code_package 'CTB routes' {
          summary 'Admin route definitions for content type, component, and schema builder operations'
          description 'Admin route definitions for content type, component, and schema builder operations.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-type-builder/server/src/routes' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server/src/routes 'Implementation'
        }

        ctb_server_controllers = code_package 'CTB controllers' {
          summary 'Controller handlers for Content-Type Builder admin requests'
          description 'Controller handlers for Content-Type Builder admin requests.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-type-builder/server/src/controllers' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server/src/controllers 'Implementation'
        }

        ctb_server_services = code_package 'CTB services' {
          summary 'Services that create, update, delete, and validate content type and component schema definitions'
          description 'Services that create, update, delete, and validate content type and component schema definitions.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-type-builder/server/src/services' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server/src/services 'Implementation'
        }

        ctb_schema_builder = code_package 'Schema builder services' {
          summary 'Schema builder internals used to compose and persist content type and component schema changes'
          description 'Schema builder internals used to compose and persist content type and component schema changes.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-type-builder/server/src/services/schema-builder' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server/src/services/schema-builder 'Implementation'
        }

        ctb_server_middlewares = code_package 'CTB middlewares and validation' {
          summary 'Middleware and validation modules used before Content-Type Builder controller execution'
          description 'Middleware and validation modules used before Content-Type Builder controller execution.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/content-type-builder/server/src/middlewares, packages/core/content-type-builder/server/src/controllers/validation' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server/src/middlewares 'Implementation'
          link https://github.com/strapi/strapi/tree/develop/packages/core/content-type-builder/server/src/controllers/validation 'Implementation'
        }
      }

      plugin_system = component 'Plugin system' {
        summary 'Loads enabled plugins and registers their server contributions.'

        description 'Discovers enabled plugins, loads strapi-server entrypoints, and wires plugin routes, controllers, services, policies, middlewares, content types, and lifecycles into the runtime.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/loaders/plugins, packages/core/core/src/services/server/register-routes.ts' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/loaders/plugins 'Implementation'
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/server/register-routes.ts 'Implementation'
      }

      plugin_modules = component 'Plugin modules' {
        summary 'Enabled server-side plugin functionality.'

        description 'Concrete official and application plugins loaded by the plugin system.'
        technology 'TypeScript'
        metadata { implementation 'packages/plugins, packages/core/* plugins, app plugins' }
        link https://github.com/strapi/strapi/tree/develop/packages/plugins 'Implementation'
      }

      document_service = component 'Document Service' {
        summary 'Reads, edits and publishes content documents.'

        description 'Primary high-level content API for reading and writing content documents.'
        technology 'TypeScript'
        metadata { implementation 'packages/core/core/src/services/document-service' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/document-service 'Implementation'

        ds_document_operations = code_package 'Document operations' {
          summary 'High-level document read and write operations exposed through strapi.documents'
          description 'High-level document read and write operations exposed through strapi.documents.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/document-service' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/document-service 'Implementation'
        }

        ds_transform_layer = code_package 'Transform layer' {
          summary 'Transforms document params, data, relations, and response shapes around persistence operations'
          description 'Transforms document params, data, relations, and response shapes around persistence operations.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/document-service/transform' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/document-service/transform 'Implementation'
        }

        ds_attribute_handlers = code_package 'Attribute handlers' {
          summary 'Attribute-specific behavior used by document operations'
          description 'Attribute-specific behavior used by document operations.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/document-service/attributes' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/document-service/attributes 'Implementation'
        }

        ds_middlewares = code_package 'Document middlewares' {
          summary 'Document service middleware pipeline for extending document operations'
          description 'Document service middleware pipeline for extending document operations.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/document-service/middlewares' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/document-service/middlewares 'Implementation'
        }

        ds_utils = code_package 'Document utilities' {
          summary 'Shared document service utilities'
          description 'Shared document service utilities.'
          technology 'TypeScript'
          metadata { implementation 'packages/core/core/src/services/document-service/utils' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/core/src/services/document-service/utils 'Implementation'
        }
      }

      database_layer = component 'Database abstraction' {
        summary 'Persists entries and relations through the query engine.'
        description 'Database abstraction used by the server runtime to query and persist content, relations, components, users, roles, and API tokens.'
        technology '@strapi/database'
      }
    }

    admin_web_app = container 'Admin web application' {
      summary 'React workspace for content teams, running in the browser.'

      description 'React admin dashboard bundle used by content editors and administrators. It can be built and served separately from the server runtime.'
      technology 'React / browser'

      admin_shell = component 'Admin shell' {
        summary 'Hosts navigation, context and feature extensions.'

        description 'Core React admin application shell, routing, layout, and plugin extension host.'
        technology 'React / TypeScript'
        metadata { implementation 'packages/core/admin/admin/src' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/admin/admin/src 'Implementation'

        admin_app_entry = code_package 'Admin app entry' {
          summary 'Admin application entry modules and app bootstrap wiring'
          description 'Admin application entry modules and app bootstrap wiring.'
          technology 'React / TypeScript'
          metadata { implementation 'packages/core/admin/admin/src' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/admin/admin/src 'Implementation'
        }

        admin_extension_api = code_package 'Admin extension API' {
          summary 'Admin-side extension registration surface used by features and plugins'
          description 'Admin-side extension registration surface used by features and plugins.'
          technology 'React / TypeScript'
          metadata { implementation 'packages/core/admin/admin/src/core/apis' }
          link https://github.com/strapi/strapi/tree/develop/packages/core/admin/admin/src/core/apis 'Implementation'
        }
      }

      admin_providers = component 'Admin providers' {
        summary 'Supplies app context, identity, theme and data providers.'

        description 'Top-level React providers for Strapi app context, Redux, React Query, auth, history, language, theme, notifications, tracking, guided tours, and configuration.'
        technology 'React / TypeScript'
        metadata { implementation 'packages/core/admin/admin/src/components/Providers.tsx, packages/core/admin/admin/src/features' }
        link https://github.com/strapi/strapi/tree/develop/packages/core/admin/admin/src/components/Providers.tsx 'Implementation'
        link https://github.com/strapi/strapi/tree/develop/packages/core/admin/admin/src/features 'Implementation'

        admin_context_providers = code_package 'Application context providers' {
          summary 'Providers for Strapi app context, configuration, language, theme, notifications, tracking, and guided tours'
          description 'Providers for Strapi app context, configuration, language, theme, notifications, tracking, and guided tours.'
