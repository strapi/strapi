    admin_web_app -> server_runtime 'Calls Admin APIs' 'HTTP(S)' { #runtime_boundary }
    cli_tooling -> application_source 'scaffolds project and API source files' 'File system'
    server_runtime -> application_source 'loads application definitions at startup'
    server_runtime -> database 'Reads and writes application data' 'SQL' { #runtime_boundary }
  }

  public_client -> strapi 'Consumes published content through Content APIs' 'HTTP'
  strapi.server_runtime -> external_system 'Sends configured webhook events' 'HTTP(S)'
  content_editor -> strapi 'Creates, edits, reviews, and publishes entries' 'Admin UI'
  developer -> strapi 'Builds schemas, APIs, extensions, and deployment configuration' 'Code, CLI, and Admin UI'
  administrator -> strapi 'Configures users, roles, permissions, tokens, webhooks, and operational settings' 'Admin UI'
  content_editor -> strapi.admin_web_app 'uses the Admin in a browser'
  public_client -> strapi.server_runtime 'requests content' 'HTTP(S) / JSON'
  strapi.server_runtime.http_server -> strapi.server_runtime.endpoint_composer 'dispatches matched route handlers'
  strapi.server_runtime.http_server -> strapi.server_runtime.auth 'uses route access checks'
  strapi.server_runtime.http_server -> strapi.server_runtime.admin_server_apis 'dispatches admin settings requests'
