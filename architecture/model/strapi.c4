    database = database 'Application database' {
      summary 'Stores content, identities and configuration.'

      description 'Configured application database: SQLite, PostgreSQL, MySQL, or MariaDB.'
      technology 'Configured SQL database'
    }

    application_source = code_package 'Application source files' {
      summary 'Application schemas, API code and customizations.'

      description 'Files in a Strapi application that describe content schemas and application API modules.'

      content_type_schema_files = source_document 'Content type schema files' {
        summary 'Application content types and component definitions.'
        description 'Application content-type schema.json files and component definitions. Installed plugin schemas are exported by plugin packages; application plugin overrides are a separate artifact.'
        technology 'JSON'
        metadata { implementation 'src/api/**/content-types/**/schema.json, src/components/**' }
      }

      api_module_files = code_package 'Application API modules' {
        summary 'Custom routes, controllers, services, policies and middleware.'
        description 'Application route, controller, service, policy, and middleware modules loaded into the runtime.'
        technology 'TypeScript'
        metadata { implementation 'src/api/**/routes, controllers, services, policies, middlewares' }
      }
    }

    admin_web_app.content_type_builder_ui -> server_runtime.content_type_builder_server 'calls schema builder admin endpoints'
    server_runtime.content_type_builder_server -> application_source.content_type_schema_files 'writes schema definitions'
    cli_tooling.generators -> application_source.content_type_schema_files 'scaffolds schema files'
    cli_tooling.generators -> application_source.api_module_files 'scaffolds API modules'

    server_runtime.schema_loader -> application_source.content_type_schema_files 'reads schemas at startup'
    server_runtime.schema_loader -> server_runtime.schema_sync 'provides loaded content type definitions'
    server_runtime.schema_sync -> server_runtime.database_layer 'synchronizes database schema'
    server_runtime.schema_loader -> server_runtime.core_api_layer 'provides content type metadata for generated APIs'
    server_runtime.api_module_loader -> application_source.api_module_files 'loads route, controller, service, policy, and middleware modules'
    server_runtime.api_module_loader -> server_runtime.route_registration 'provides loaded routers'

    server_runtime.route_registration -> server_runtime.endpoint_composer 'composes each endpoint'
    server_runtime.route_registration -> server_runtime.core_api_layer 'instantiates generated app API routers'
    server_runtime.route_registration -> server_runtime.content_api 'marks Content API routes and applies extra route parameters'
    server_runtime.endpoint_composer -> server_runtime.auth 'authenticates and authorizes requests'
    server_runtime.endpoint_composer -> server_runtime.core_api_layer 'invokes generated controller actions'
    server_runtime.endpoint_composer -> server_runtime.admin_server_apis 'invokes admin controllers'

    server_runtime.content_api -> server_runtime.content_api_permissions 'owns permission action registry and ability engine'
    server_runtime.content_api -> server_runtime.content_api_validation 'exposes validate and sanitize helpers'
    server_runtime.content_api.ca_route_metadata -> server_runtime.content_api.ca_permission_providers 'provides action names and route scopes'
    server_runtime.content_api.ca_permission_providers -> server_runtime.content_api.ca_validation_helpers 'shares Content API context'
    server_runtime.content_api.ca_route_schemas -> server_runtime.content_api.ca_validation_helpers 'provides route-level schemas'
    server_runtime.auth -> server_runtime.content_api_token_strategy 'uses strategy for bearer API tokens'
    server_runtime.auth -> server_runtime.users_permissions_strategy 'uses strategy for JWT users and public role access'
    server_runtime.auth.auth_strategy_registry -> server_runtime.auth.auth_request_context 'creates request auth context'
    server_runtime.auth.auth_request_context -> server_runtime.auth.auth_authorization_step 'provides credentials and abilities'
    server_runtime.content_api_token_strategy -> server_runtime.content_api_permissions 'generates ability for custom token permissions'
    server_runtime.users_permissions_strategy -> server_runtime.content_api_permissions 'generates ability for role permissions'

    server_runtime.core_api_layer -> server_runtime.content_api 'uses Content API validate and sanitize helpers'
    server_runtime.core_api_layer -> server_runtime.content_api_validation 'validates and sanitizes Content API requests and responses'
    server_runtime.core_api_layer -> server_runtime.document_service 'delegates content operations'
    server_runtime.core_api_layer.core_api_routes -> server_runtime.core_api_layer.core_api_controllers 'routes generated actions'
    server_runtime.core_api_layer.core_api_controllers -> server_runtime.core_api_layer.core_api_services 'delegates generated service calls'
    server_runtime.core_api_layer.core_api_controllers -> server_runtime.content_api 'uses validation and sanitization helpers'
    server_runtime.core_api_layer.core_api_services -> server_runtime.document_service 'uses document operations'
    server_runtime.admin_server_apis -> server_runtime.content_api 'exposes Content API routes and permission metadata to admin settings'
    server_runtime.content_type_builder_server.ctb_server_routes -> server_runtime.content_type_builder_server.ctb_server_middlewares 'applies CTB middleware'
    server_runtime.content_type_builder_server.ctb_server_routes -> server_runtime.content_type_builder_server.ctb_server_controllers 'dispatches CTB requests'
    server_runtime.content_type_builder_server.ctb_server_controllers -> server_runtime.content_type_builder_server.ctb_server_services 'delegates schema operations'
    server_runtime.content_type_builder_server.ctb_server_services -> server_runtime.content_type_builder_server.ctb_schema_builder 'builds schema changes'
