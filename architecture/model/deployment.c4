deployment {
  environment self_hosted {
    title 'Example: single-host production'
    device browser {
      title 'Editor’s browser'
      admin = instanceOf strapi.admin_web_app
    }
    host machine {
      title 'Self-hosted application machine'
      server = instanceOf strapi.server_runtime
      database = instanceOf strapi.database {
        title 'Application database (SQLite)'
      }
      media = instanceOf strapi.local_media
    }
  }
}

views {
  deployment view self_hosted_deployment {
    title '04 Deployment / Single-host example'
    description '''
      **Example configuration:** one production Node.js server, a persistent SQLite database, and the local upload provider.
      The Admin JavaScript runs in the editor’s browser, even when served by the same server.
      Retain the database and media across application replacement. Reverse proxies, TLS termination and backups are omitted.
      PostgreSQL/MySQL and remote media providers are alternatives; this diagram makes no claim about a multi-replica topology.
      Content-Type Builder changes happen in development and are delivered through deployment, not this production runtime.
    '''
    include self_hosted.**
    exclude * -> *
    include * -> * where tag is #runtime_boundary
    autoLayout LeftRight 70 40
  }
}
