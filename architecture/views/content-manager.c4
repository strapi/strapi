views {
  view content_manager_components of strapi.server_runtime {
    title '03 Engineering / Content Manager / Editing and permissions'
    description 'Content Manager controllers coordinate admin permissions, response shaping and document operations. Routine content writes go through the Document Service; targeted count/existence queries also use the database abstraction. Routing and feature module details are in the server code reference.'
    include
      cm_controllers,
      cm_permission_services,
      cm_schema_configuration,
      cm_populate_metadata,
      cm_document_manager,
      document_service,
      database_layer
    exclude * -> *
    include
      cm_controllers -> cm_permission_services with { title 'Checks admin permissions' },
      cm_controllers -> cm_schema_configuration with { title 'Loads editing configuration' },
      cm_controllers -> cm_populate_metadata with { title 'Shapes the response' },
      cm_controllers -> cm_document_manager with { title 'Runs document operations' },
      cm_document_manager -> document_service with { title 'Calls strapi.documents' },
      cm_document_manager -> database_layer with { title 'Runs targeted count / existence queries' },
      document_service -> database_layer with { title 'Persists document entries' }
    autoLayout LeftRight 70 40
  }

  view content_manager_server_code of strapi.server_runtime.content_manager_server {
    title '05 Code reference / Content Manager / Server'
    description '''
      Code-level organization of the Content Manager server package: routes, middlewares, controllers, services, and feature modules.
    '''

    include
      cm_server_routes_code,
      cm_server_middlewares_code,
      cm_server_controllers_code,
      cm_server_services_code,
      cm_server_feature_modules_code,
      strapi.server_runtime.document_service,
      cm_server_routes_code -> cm_server_middlewares_code,
      cm_server_routes_code -> cm_server_controllers_code,
      cm_server_routes_code -> cm_server_feature_modules_code,
      cm_server_controllers_code -> cm_server_services_code,
      cm_server_feature_modules_code -> cm_server_services_code,
      cm_server_services_code -> strapi.server_runtime.document_service
  }
}
