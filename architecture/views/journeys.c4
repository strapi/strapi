views {
  dynamic view content_publishing_flow {
    title '02 Journeys / From draft to published content'
    description '''
      **Audience:** everyone. **Scenario:** an authorized editor saves then publishes an entry on a content type with Draft & Publish enabled.
      Later, an authorized consuming application requests published content. These are separate requests, shown together to explain the journey.
      The server groups routing, permissions and document operations; the Content API journey provides a deeper request view.
    '''
    content_editor -> strapi.admin_web_app 'Edits an entry and saves a draft'
    strapi.admin_web_app -> strapi.server_runtime 'Saves draft through the Admin API'
    strapi.server_runtime -> strapi.database 'Persists draft content'
    content_editor -> strapi.admin_web_app 'Chooses Publish'
    strapi.admin_web_app -> strapi.server_runtime 'Requests publication'
    strapi.server_runtime -> strapi.database 'Writes the published version'
    public_client -> strapi.server_runtime 'Requests published content' { navigateTo content_api_request_flow }
    strapi.server_runtime -> strapi.database 'Reads accessible published content'
    public_client <- strapi.server_runtime 'Receives content as JSON'
    autoLayout LeftRight 70 40
  }
}
