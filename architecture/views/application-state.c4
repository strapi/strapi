views {
  view application_state {
    title '04 Deployment / Application code and persistent state'
    description '''
      **Audience:** product and engineering. **Type:** construction and state map, not a deployment topology or execution sequence.
      **Question:** what is deployed, what is built, and what must survive application replacement?
      **Example:** the remote-upload configuration used by Production hosting example, where the database is PostgreSQL and media storage is S3.
      Source includes schemas, API code, plugin overrides and config files. Environment values are supplied by the deployment environment.
      The Admin bundle is generated and can be replaced. Content, identities, database-backed settings and media metadata persist in the database;
      uploaded bytes persist separately in object storage. Retaining a database does not freeze its schema: startup may synchronize it with the deployed definitions.
      With the local upload provider instead, uploaded bytes live on persistent disk and that directory must survive replacement of the application host.
      Configuration combines defaults, application config and environment-specific config. Browser build values can require rebuilding;
      a server restart alone does not rebuild the Admin. CTB edits source in development, not this production state.
      Selected build-time environment values become public in the Admin bundle; server credentials belong in runtime configuration. Existing runtime configuration must be supplied again when replacing the host.
      Open source for assembly, build for plugin entrypoints, server for startup, database for deployment, or media for the upload journey.
    '''
    include
      strapi.application_source with { navigateTo strapi_construction },
      environment_values,
      strapi.cli_tooling.admin_build with { navigateTo strapi_extensions },
      strapi.admin_browser_bundle with { navigateTo strapi_containers },
      strapi.server_runtime with { navigateTo strapi_startup },
      strapi.database with { navigateTo self_hosted_deployment },
      media_storage with { title 'Remote media storage' navigateTo media_upload_flow }
    exclude * -> *
    include
      strapi.server_runtime -> strapi.application_source with { title 'Loads definitions and configuration' },
      strapi.server_runtime -> environment_values,
      strapi.cli_tooling.admin_build -> strapi.application_source,
      strapi.cli_tooling.admin_build -> environment_values,
      strapi.cli_tooling.admin_build -> strapi.admin_browser_bundle,
      strapi.server_runtime -> strapi.admin_browser_bundle,
      strapi.server_runtime -> strapi.database with { title 'Persists content, identities, settings and media metadata' },
      strapi.server_runtime -> media_storage with { title 'Persists files via remote upload provider' }
    autoLayout TopBottom 70 50
  }
}
