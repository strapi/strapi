views {
  view admin_app_components of strapi.admin_web_app {
    title '03 Engineering / Admin / Application overview'
    description '''
      **Audience:** engineers. **Question:** how does the Admin organize its browser features?
      **Scope:** browser responsibilities and their HTTP boundary. Core routing selects feature UIs; HTTP requests cross into the server.
      Feature cards are modules in one browser application, not separately deployed frontends. Server APIs enforce permissions even when the UI hides unavailable actions.
      Open the Admin shell for frontend foundations, the server for feature API boundaries, or a feature for its code map.
    '''
    include
      admin_shell with { navigateTo admin_frontend_foundation },
      admin_router,
      content_manager_ui,
      content_type_builder_ui,
      settings_api_tokens_ui,
      plugin_admin_extensions,
      strapi.server_runtime with { navigateTo admin_feature_surfaces }
    exclude * -> *
    include
      admin_shell -> admin_router,
      admin_router -> content_manager_ui,
      admin_router -> content_type_builder_ui,
      admin_router -> settings_api_tokens_ui,
      admin_shell -> plugin_admin_extensions,
      content_manager_ui -> strapi.server_runtime with { title 'Edits and publishes content' technology 'HTTP(S)' navigateTo content_publishing_flow },
      content_type_builder_ui -> strapi.server_runtime with { title 'Changes schemas in development' technology 'HTTP(S)' navigateTo content_type_builder_schema_change_flow },
      settings_api_tokens_ui -> strapi.server_runtime with { title 'Configures administration' technology 'HTTP(S)' },
      plugin_admin_extensions -> strapi.server_runtime with { title 'Calls plugin endpoints' technology 'HTTP(S)' }
    autoLayout LeftRight 70 40
  }

  view admin_frontend_foundation of strapi.admin_web_app {
    title '03 Engineering / Admin / Frontend foundation'
    description '''
      **Audience:** frontend engineers. **Question:** what supplies routing, context, state and data access to Admin pages?
      **Scope:** browser composition and dependencies, not a request sequence. React providers supply context and client state; they are unrelated to server upload/email providers.
      Redux holds shared state and RTK Query cache state. Registering API reducers/middleware connects that cache to the store; it does not itself issue a request.
      Pages use API services for data. Context providers also include React Query; the Redux store does not represent every browser cache.
      Open the shell, providers, router or API services for their code references. Shared UI components remain in the feature code maps.
    '''

    include
      admin_shell with { navigateTo admin_shell_code },
      admin_providers with { navigateTo admin_providers_code },
      admin_router with { navigateTo admin_router_code },
      admin_store,
      admin_api_services with { navigateTo admin_api_services_code },
      admin_feature_providers,
      admin_layouts,
      admin_pages
    exclude * -> *
    include
      admin_shell -> admin_providers,
      admin_shell -> admin_router,
      admin_shell -> admin_layouts,
      admin_providers -> admin_store,
      admin_providers -> admin_feature_providers,
      admin_store -> admin_api_services,
      admin_router -> admin_pages,
      admin_pages -> admin_api_services
    autoLayout LeftRight 65 40
  }

  view admin_feature_surfaces of strapi.admin_web_app {
    title '03 Engineering / Admin / Feature API boundaries'
    description '''
      **Audience:** engineers. **Question:** which server API serves each Admin feature?
      **Scope:** runtime HTTP boundaries. Browser modules call APIs hosted in the same Strapi server; the server cards are not separate services to deploy.
      The plugin UI is bundled during the Admin build. Content-Type Builder mutation routes require development autoReload.
      Open a server feature for its implementation; open plugin modules for how extension entrypoints are assembled.
    '''
    include
      content_manager_ui,
      content_type_builder_ui,
      settings_api_tokens_ui,
      plugin_admin_extensions,
      strapi.server_runtime.content_manager_server,
      strapi.server_runtime.content_type_builder_server,
      strapi.server_runtime.admin_server_apis,
      strapi.server_runtime.plugin_modules with { navigateTo strapi_extensions }
    exclude * -> *
    include
      content_manager_ui -> strapi.server_runtime.content_manager_server with { title 'Content operations' technology 'HTTP(S)' },
      content_type_builder_ui -> strapi.server_runtime.content_type_builder_server with { title 'Schema editing (development)' technology 'HTTP(S)' },
      settings_api_tokens_ui -> strapi.server_runtime.admin_server_apis with { title 'Settings and identity' technology 'HTTP(S)' },
      plugin_admin_extensions -> strapi.server_runtime.plugin_modules with { title 'Plugin-specific requests' technology 'HTTP(S)' }
    autoLayout LeftRight 70 40
  }

  view content_manager_ui_internals of strapi.admin_web_app.content_manager_ui {
    title '05 Code reference / Admin / Content Manager UI'
    description '''
      Code organization for the Admin Content Manager frontend package: route entrypoints, layout, page surfaces, hooks, services, state, and shared UI modules.
    '''

    include
      cm_ui_plugin_entry,
      cm_ui_router,
      cm_ui_layout,
      cm_ui_list_view,
      cm_ui_edit_view,
      cm_ui_configuration_views,
      cm_ui_hooks,
      cm_ui_services,
      cm_ui_state,
      cm_ui_shared_components,
      cm_ui_history_preview,
      strapi.server_runtime,
      strapi.server_runtime.content_manager_server,
      cm_ui_plugin_entry -> cm_ui_router,
      cm_ui_plugin_entry -> cm_ui_shared_components,
      cm_ui_router -> cm_ui_layout,
      cm_ui_router -> cm_ui_list_view,
      cm_ui_router -> cm_ui_edit_view,
      cm_ui_router -> cm_ui_configuration_views,
      cm_ui_router -> cm_ui_history_preview,
      cm_ui_layout -> cm_ui_hooks,
      cm_ui_layout -> cm_ui_shared_components,
      cm_ui_list_view -> cm_ui_hooks,
      cm_ui_list_view -> cm_ui_services,
      cm_ui_list_view -> cm_ui_shared_components,
      cm_ui_edit_view -> cm_ui_hooks,
      cm_ui_edit_view -> cm_ui_services,
      cm_ui_edit_view -> cm_ui_shared_components,
      cm_ui_configuration_views -> cm_ui_services,
      cm_ui_hooks -> cm_ui_state,
      cm_ui_hooks -> cm_ui_services,
      cm_ui_services -> strapi.server_runtime.content_manager_server,
      cm_ui_history_preview -> cm_ui_services
    autoLayout LeftRight 70 40
  }

  view admin_shell_code of strapi.admin_web_app.admin_shell {
    title '05 Code reference / Admin / Admin Shell'
    description '''
      Code-level organization of the Admin shell entrypoint and extension API.
    '''

    include
      admin_app_entry,
      admin_extension_api,
      strapi.admin_web_app.admin_router,
      admin_app_entry -> admin_extension_api,
      admin_extension_api -> strapi.admin_web_app.admin_router.admin_plugin_routes
  }

  view admin_router_code of strapi.admin_web_app.admin_router {
    title '05 Code reference / Admin / Admin Router'
    description '''
      Code-level organization of Admin routing: auth routes, authenticated layout routes, and feature/plugin routes.
    '''

    include
      admin_auth_routes,
      admin_authenticated_routes,
      admin_plugin_routes,
      admin_auth_routes -> admin_authenticated_routes,
      admin_authenticated_routes -> admin_plugin_routes
  }

  view admin_providers_code of strapi.admin_web_app.admin_providers {
    title '05 Code reference / Admin / Admin Providers'
    description '''
      Code-level organization of Admin app providers for context, configuration, Redux, and server data.
    '''

    include
      admin_context_providers,
      admin_data_providers,
      strapi.admin_web_app.admin_store,
      strapi.admin_web_app.admin_feature_providers,
      admin_context_providers -> strapi.admin_web_app.admin_feature_providers,
      admin_data_providers -> strapi.admin_web_app.admin_store
  }

  view admin_api_services_code of strapi.admin_web_app.admin_api_services {
    title '05 Code reference / Admin / Admin API Services'
    description '''
      Code-level organization of Admin RTK Query services and settings/auth API modules.
    '''

    include
      admin_api_base,
      admin_auth_api,
      admin_settings_api,
      strapi.server_runtime,
      strapi.server_runtime.admin_server_apis,
      admin_api_base -> admin_auth_api,
      admin_api_base -> admin_settings_api,
      admin_settings_api -> strapi.server_runtime.admin_server_apis
  }

  view content_type_builder_ui_code of strapi.admin_web_app.content_type_builder_ui {
    title '05 Code reference / Admin / Content-Type Builder UI'
    description '''
      Code-level organization of the Content-Type Builder frontend package: app pages, data manager, schema components, form modals, and utilities.
    '''

    include
      ctb_ui_app_pages,
      ctb_ui_data_manager,
      ctb_ui_schema_components,
      ctb_ui_form_modals,
      ctb_ui_utils,
      strapi.server_runtime,
      strapi.server_runtime.content_type_builder_server,
      ctb_ui_app_pages -> ctb_ui_data_manager,
      ctb_ui_app_pages -> ctb_ui_schema_components,
      ctb_ui_schema_components -> ctb_ui_form_modals,
      ctb_ui_form_modals -> ctb_ui_data_manager,
      ctb_ui_data_manager -> strapi.server_runtime.content_type_builder_server,
      ctb_ui_schema_components -> ctb_ui_utils
  }

  view settings_api_tokens_ui_code of strapi.admin_web_app.settings_api_tokens_ui {
    title '05 Code reference / Admin / Settings and API Tokens UI'
    description '''
      Code-level organization of settings pages for API tokens, roles, users, transfer tokens, and webhooks.
    '''

    include
      settings_navigation,
      api_tokens_pages,
      admin_roles_pages,
      transfer_tokens_webhooks_pages,
      strapi.admin_web_app.admin_api_services,
      settings_navigation -> api_tokens_pages,
      settings_navigation -> admin_roles_pages,
      settings_navigation -> transfer_tokens_webhooks_pages,
      api_tokens_pages -> strapi.admin_web_app.admin_api_services.admin_settings_api,
      admin_roles_pages -> strapi.admin_web_app.admin_api_services.admin_settings_api
  }
}
