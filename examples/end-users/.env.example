HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"

# The address Strapi is served from, and the origin(s) of the example front end (examples/end-users-frontend),
# separated by commas.
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://localhost:5173

# Signs the end-user sessions. Use a long random string (for example: openssl rand -base64 32).
END_USERS_SECRET=change-me-to-a-long-random-string
