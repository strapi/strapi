# The Strapi application (examples/end-users). Origin only: Better Auth adds /api/auth.
VITE_STRAPI_URL=http://localhost:1337

# How the browser proves who it is: `cookie` (the session cookie Strapi sets) or `bearer` (a token the
# front end keeps and sends in the Authorization header). A `?mode=cookie|bearer` query parameter on
# any page overrides this for that browser tab.
VITE_AUTH_MODE=cookie
