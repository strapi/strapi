{
  "name": "@strapi/plugin-end-users",
  "version": "5.61.0",
  "description": "End-user authentication for Strapi, built on Better Auth.",
  "homepage": "https://strapi.io",
  "bugs": {
    "url": "https://github.com/strapi/strapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/strapi/strapi.git",
    "directory": "packages/plugins/end-users"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Strapi Solutions SAS",
    "email": "hi@strapi.io",
    "url": "https://strapi.io"
  },
  "maintainers": [
    {
      "name": "Strapi Solutions SAS",
      "email": "hi@strapi.io",
      "url": "https://strapi.io"
    }
  ],
  "exports": {
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./auth": {
      "types": "./dist/server/src/engine/better-auth/public/auth.d.ts",
      "source": "./server/src/engine/better-auth/public/auth.ts",
      "import": "./dist/server/auth.mjs",
      "require": "./dist/server/auth.js",
      "default": "./dist/server/auth.js"
    },
    "./auth/plugins": {
      "types": "./dist/server/src/engine/better-auth/public/plugins.d.ts",
      "source": "./server/src/engine/better-auth/public/plugins.ts",
      "import": "./dist/server/auth/plugins.mjs",
      "require": "./dist/server/auth/plugins.js",
      "default": "./dist/server/auth/plugins.js"
    },
    "./auth/passkey": {
      "types": "./dist/server/src/engine/better-auth/public/passkey.d.ts",
      "source": "./server/src/engine/better-auth/public/passkey.ts",
      "import": "./dist/server/auth/passkey.mjs",
      "require": "./dist/server/auth/passkey.js",
      "default": "./dist/server/auth/passkey.js"
    },
    "./providers": {
      "types": "./dist/server/src/providers/public.d.ts",
      "source": "./server/src/providers/public.ts",
      "import": "./dist/server/providers.mjs",
      "require": "./dist/server/providers.js",
      "default": "./dist/server/providers.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "auth": [
        "./dist/server/src/engine/better-auth/public/auth.d.ts"
      ],
      "auth/plugins": [
        "./dist/server/src/engine/better-auth/public/plugins.d.ts"
      ],
      "auth/passkey": [
        "./dist/server/src/engine/better-auth/public/passkey.d.ts"
      ],
      "providers": [
        "./dist/server/src/providers/public.d.ts"
      ]
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "run -T npm-run-all clean --parallel build:code build:types",
    "build:code": "run -T rollup -c",
    "build:types": "run -T run-p build:types:server build:types:admin",
    "build:types:server": "run -T tsc -p server/tsconfig.build.json --emitDeclarationOnly",
    "build:types:admin": "run -T tsc -p admin/tsconfig.build.json --emitDeclarationOnly",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint . --max-warnings=0",
    "test:front": "run -T cross-env IS_EE=true jest --config ./jest.config.front.js",
    "test:ts:back": "run -T tsc -p server/tsconfig.json",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "watch": "run -T rollup -c -w",
    "test:unit:vitest": "vitest run",
    "test:unit:vitest:watch": "vitest --watch"
  },
  "dependencies": {
    "@better-auth/core": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@reduxjs/toolkit": "1.9.7",
    "@strapi/design-system": "2.3.0",
    "@strapi/icons": "2.3.0",
    "bcryptjs": "2.4.3",
    "better-auth": "1.7.14",
    "better-call": "1.4.4",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.29.7",
    "nanostores": "1.5.5",
    "react-intl": "6.6.2",
    "react-redux": "8.1.3"
  },
  "devDependencies": {
    "@strapi/admin": "5.61.0",
    "@strapi/admin-test-utils": "5.61.0",
    "@strapi/database": "5.61.0",
    "@strapi/strapi": "5.61.0",
    "@strapi/types": "5.61.0",
    "@strapi/utils": "5.61.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bcryptjs": "2.4.3",
    "@types/jest": "29.5.2",
    "@types/jsonwebtoken": "9.0.3",
    "@types/koa": "2.15.2",
    "@types/node": "22.20.0",
    "eslint-config-custom": "5.61.0",
    "jest": "29.6.0",
    "koa": "2.16.4",
    "msw": "2.13.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "6.4.1",
    "tsconfig": "5.61.0",
    "typescript": "5.9.3",
    "vitest": "catalog:",
    "vitest-config": "5.61.0"
  },
  "peerDependencies": {
    "@strapi/admin": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "displayName": "End Users",
    "name": "end-users",
    "description": "End-user authentication for Strapi, built on Better Auth.",
    "kind": "plugin"
  }
}
