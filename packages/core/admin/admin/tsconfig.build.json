{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "../dist",
    "noEmit": false,
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
    "types": ["@testing-library/jest-dom", "vite/client", "@strapi/types/globals-admin"]
  },
  "include": ["./src", "../ee/admin", "../package.json", "./tests"],
  "references": [{ "path": "../shared/tsconfig.build.json" }],
  "exclude": [
    "**/__mocks__",
    "./src/**/tests",
    "**/*.test.*",
    "../ee/admin/**/*.test.*",
    "../ee/admin/**/__mocks__"
  ]
}
