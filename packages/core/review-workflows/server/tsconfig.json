{
  "extends": "tsconfig/server.json",
  "include": ["src", "../shared"],
  "compilerOptions": {
    // Tests run on vitest: drop the jest globals the server preset loads.
    "types": ["node", "@strapi/strapi/strict-types"],
    // Resolve our own contracts from source: `@strapi/strapi/strict-types` would load our dist instead.
    "paths": {
      "@strapi/review-workflows/strapi-server": ["./src/index.ts"]
    }
  }
}
