exports[`write rules with strict types, attributes of a component carry their write rule 1`] = `
"import type { Schema, Struct } from "@strapi/strapi";

export interface SharedRules extends Struct.ComponentSchema {
    collectionName: 'rules';
    info: {
        displayName: 'Rule';
        pluralName: 'rules';
        singularName: 'rule';
    };
    attributes: {
        /** Required when published, only with \`api.documents.strictRelations\`. */
        author: Schema.Attribute.Relation<'manyToOne', 'admin::user'> & Schema.Attribute.Required;
        /** Required on every create, drafts included (\`[]\` is enough). Never \`null\`. */
        blocks: Schema.Attribute.DynamicZone<[
            "shared.tag"
        ]> & Schema.Attribute.Required;
        createdBy: Schema.Attribute.Relation<'oneToOne', 'admin::user'>;
        /** Never \`null\`. */
        extras: Schema.Attribute.Component<'shared.tag', true>;
        /** Default: "news". \`null\` only in drafts. */
        kind: Schema.Attribute.Enumeration<[
            'news',
            'blog'
        ]> & Schema.Attribute.Required & Schema.Attribute.DefaultTo<'news'>;
        subtitle: Schema.Attribute.String;
        /** Required on every create, drafts included (\`[]\` is enough). Never \`null\`. */
        tags: Schema.Attribute.Component<'shared.tag', true> & Schema.Attribute.Required;
        /** Required only when its condition shows it. */
        teaser: Schema.Attribute.Text & Schema.Attribute.Required & Schema.Attribute.Conditional;
        /** Required when published. \`null\` only in drafts. */
        title: Schema.Attribute.String & Schema.Attribute.Required;
        /** Default: 0. */
        views: Schema.Attribute.Integer & Schema.Attribute.DefaultTo<0>;
    };
}

declare global {
    namespace Strapi {
        namespace Registries {
            interface ComponentSchemas {
                'shared.rules': SharedRules;
            }
        }
    }
}
"
`;

