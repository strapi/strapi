exports[`content types generator with strict types, schemas augment the global Strapi.Registries namespace 1`] = `
"import type { Schema, Struct } from "@strapi/strapi";

export interface AdminUser extends Struct.CollectionTypeSchema {
    collectionName: 'admin_users';
    info: {
        displayName: 'User';
        pluralName: 'users';
        singularName: 'user';
    };
    options: {
        draftAndPublish: false;
    };
    attributes: {
        /** Required. Never \`null\`. */
        email: Schema.Attribute.Email & Schema.Attribute.Required;
    };
}

export interface ApiArticleArticle extends Struct.CollectionTypeSchema {
    collectionName: 'articles';
    info: {
        displayName: 'Article';
        pluralName: 'articles';
        singularName: 'article';
    };
    options: {
        draftAndPublish: true;
    };
    attributes: {
        author: Schema.Attribute.Relation<'manyToOne', 'admin::user'>;
        seo: Schema.Attribute.Component<'shared.seo', false>;
        /** Required when published. \`null\` only in drafts. */
        title: Schema.Attribute.String & Schema.Attribute.Required;
    };
}

export interface ApiHomepageHomepage extends Struct.SingleTypeSchema {
    collectionName: 'homepages';
    info: {
        displayName: 'Homepage';
        pluralName: 'homepages';
        singularName: 'homepage';
    };
    attributes: {
        headline: Schema.Attribute.Text;
    };
}

declare global {
    namespace Strapi {
        namespace Registries {
            interface AppContentTypeSchemas {
                'admin::user': AdminUser;
                'api::article.article': ApiArticleArticle;
                'api::homepage.homepage': ApiHomepageHomepage;
            }
        }
    }
}
"
`;

